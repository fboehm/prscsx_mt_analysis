# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# Simulation sweep outputs (regenerable, can be large)
sim_sweep/results/
sim_sweep/logs/
sim_sweep/job_list*.txt
sim_sweep/all_results.csv
sim_sweep/deltas.csv
# PRSxtra per-replicate tree (commit sim_sweep/all_results_prsxtra.csv + analysis_prsxtra/ instead)
sim_sweep/results_prsxtra*/
sim_sweep/results_v2/
# Alternative sweep trees (results_v2/ etc.): ignore the per-replicate tree, but
# keep the collected CSVs trackable -- the Snakefile writes them inside the
# results tree so runs can't clobber each other. A plain `dir/` exclude cannot be
# re-included by a later negation, hence the `/**` form.
sim_sweep/results_v*/**
!sim_sweep/results_v*/all_results.csv
!sim_sweep/results_v*/deltas*.csv

# Real-data inputs / tools / outputs (large, regenerable)
data/
tools/
results/prsxtra_aou/

# Snakemake bookkeeping
.snakemake/

# Ad-hoc comparison/test outputs (regenerable)
comparison_output/
test_output/
underrep_rescue_output/

# OS junk
.DS_Store
Thumbs.db

# Chain-length check outputs (cluster)
sim_sweep/chain_length/out/
sim_sweep/chain_length/logs/


download_*.log
