"""
Snakefile — PRS-CSx-MT simulation sweep (Slurm-ready)
=====================================================

A Snakemake wrapper over the sim_sweep harness. It replaces the hand-rolled
sbatch array (generate_job_list.py + submit_jobs.sh) with a DAG that tracks and
retries each (scenario, seed) replicate individually, then collects everything.

    rule all
      └── collect               (collect_results.py → all_results.csv, deltas.csv)
            └── run_replicate    (run_one_replicate.py, one job per scenario×seed)
                  → results/{scenario}/seed_{seed}/result.csv

    rule prsxtra                (separate target — PRS-CSx-MT vs PRSxtra)
      ├── analyze_prsxtra       (analyze_prsxtra.py → analysis_prsxtra/report.md,
      │                          CSV tables, figures)
      └── collect_prsxtra       (compare_prsxtra.py --collect → all_results_prsxtra.csv,
            │                    next to all_results.csv)
            └── run_prsxtra      (compare_prsxtra.py, one job per scenario×seed×phi)
                  → results_prsxtra/{scenario}/seed_{seed}/result_prsxtra_phi{phi}.csv

Scenarios come from scenarios.json (same file the manual harness uses); seeds
are 1..n_replicates. With the shipped scenarios.json (49 scenarios) and the
default 30 replicates that is 1470 replicate jobs. The PRSxtra comparison runs
only the prsxtra_groups scenarios (default: the 25-scenario rg_frac_grid), once
per value in prsxtra_phi: 750 jobs per phi value.

Run it
------
Always run from inside this directory so paths resolve as the harness expects:

    cd sim_sweep

Local (laptop / one node), 8 cores:

    snakemake -s Snakefile --cores 8

Dry run (prints the DAG, executes nothing — good first check):

    snakemake -s Snakefile -n

PRS-CSx-MT vs PRSxtra comparison only (does not touch the main sweep):

    snakemake -s Snakefile --profile profiles/slurm prsxtra

On Slurm (Snakemake 8+, the version profiles/slurm targets):

    pip install snakemake-executor-plugin-slurm       # once, in your snakemake env
    # edit profiles/slurm/config.yaml first: set slurm_partition (and slurm_account
    # only if your cluster needs one). --jobs there caps how many jobs queue at once.
    snakemake -s Snakefile --profile profiles/slurm

    # Slurm logs are written under .snakemake/slurm_logs/ by the executor plugin.

On Snakemake 7.x (generic --cluster), the profile instead needs a
`cluster: "sbatch ..."` block — see git history for that form.

Notes
-----
* Each replicate needs numpy + scipy + h5py and the two sibling repos PRScsx_mt
  and PRScsx. Point `python` (config) at an interpreter that has the packages,
  and either export PRSCSX_MT_DIR / PRSCSX_DIR before submitting or set
  prscsx_mt_dir / prscsx_dir in config.yaml (the latter is exported into every
  job, which is robust on clusters that don't propagate the submit environment).
* Per-replicate runtime and memory scale with the scenario's n_trait × n_pop and
  with the retry attempt (a job that times out is retried with more time/RAM).
* `collect` and `all` are local rules — they run on the submit node, not Slurm.
"""

import json
from pathlib import Path

# ---------------------------------------------------------------------------
# Paths — everything is anchored to this Snakefile's directory (sim_sweep/),
# so outputs land here regardless of where snakemake is invoked from.
# ---------------------------------------------------------------------------
SWEEP_DIR = Path(workflow.basedir)

configfile: str(SWEEP_DIR / "config.yaml")

SCENARIOS_FILE = config.get("scenarios_file") or str(SWEEP_DIR / "scenarios.json")
RESULTS_DIR    = config.get("results_dir")    or str(SWEEP_DIR / "results")
RUNNER         = str(SWEEP_DIR / "run_one_replicate.py")
COLLECTOR      = str(SWEEP_DIR / "collect_results.py")
PRSXTRA_RUNNER = str(SWEEP_DIR / "compare_prsxtra.py")
PRSXTRA_ANALYZER = str(SWEEP_DIR / "analyze_prsxtra.py")
PRSXTRA_DIR    = config.get("prsxtra_results_dir") or str(SWEEP_DIR / "results_prsxtra")

ALL_RESULTS = str(SWEEP_DIR / "all_results.csv")
DELTAS      = str(SWEEP_DIR / "deltas.csv")     # collect_results.py writes this
                                                # next to all_results.csv

# ---------------------------------------------------------------------------
# Sweep grid: scenarios × seeds
# ---------------------------------------------------------------------------
with open(SCENARIOS_FILE) as _fh:
    _SCENARIOS = json.load(_fh)

SCENARIO_META = {s["name"]: s for s in _SCENARIOS}
SCENARIOS     = list(SCENARIO_META)

N_REPLICATES = int(config.get("n_replicates", 30))
SEEDS        = list(range(1, N_REPLICATES + 1))

RESULT_CSVS = expand(
    RESULTS_DIR + "/{scenario}/seed_{seed}/result.csv",
    scenario=SCENARIOS,
    seed=SEEDS,
)

# PRS-CSx-MT vs PRSxtra grid: scenarios in prsxtra_groups × seeds × phi values.
# phi tags match compare_prsxtra.py's output names ('auto', or '%g' of the
# number — YAML may hand 1e-2 over as a string, hence the float()).
PRSXTRA_GROUPS    = config.get("prsxtra_groups", ["rg_frac_grid"])
PRSXTRA_SCENARIOS = [n for n, s in SCENARIO_META.items()
                     if s.get("group") in PRSXTRA_GROUPS]
PRSXTRA_PHIS      = ["auto" if str(p) == "auto" else "%g" % float(p)
                     for p in config.get("prsxtra_phi", ["auto"])]

PRSXTRA_CSVS = expand(
    PRSXTRA_DIR + "/{scenario}/seed_{seed}/result_prsxtra_phi{phi}.csv",
    scenario=PRSXTRA_SCENARIOS,
    seed=SEEDS,
    phi=PRSXTRA_PHIS,
)
# Small, committable outputs live in sim_sweep/ beside all_results.csv; the
# large per-replicate tree (PRSXTRA_DIR) stays out of git.
PRSXTRA_ALL      = str(SWEEP_DIR / "all_results_prsxtra.csv")
PRSXTRA_ANALYSIS = str(SWEEP_DIR / "analysis_prsxtra")
PRSXTRA_REPORT   = PRSXTRA_ANALYSIS + "/report.md"

# ---------------------------------------------------------------------------
# Per-replicate resource scaling
#
# Cost tracks the number of MCMC runs: 2 phi arms × (one PRS-CSx per trait +
# one joint PRS-CSx-MT) over n_pop populations, i.e. it grows with n_trait×n_pop.
# `attempt` escalates a retried job (e.g. one that hit the time limit).
# ---------------------------------------------------------------------------
def _units(scenario):
    s = SCENARIO_META[scenario]
    return max(1, int(s.get("n_trait", 2))) * max(1, int(s.get("n_pop", 2)))

def replicate_runtime(wildcards, attempt):        # minutes
    units = _units(wildcards.scenario)
    base  = int(config.get("runtime_base_min", 30))
    per   = int(config.get("runtime_per_unit_min", 15))
    return (base + per * units) * attempt

def replicate_mem(wildcards, attempt):            # MB
    units = _units(wildcards.scenario)
    base  = int(config.get("mem_base_mb", 4000))
    per   = int(config.get("mem_per_unit_mb", 1000))
    return (base + per * units) * attempt

# ---------------------------------------------------------------------------
# Environment prefix injected into every replicate shell.
#   * pin BLAS/OMP threads to 1 (parallelism is across jobs, not within one)
#   * optionally export the sibling-repo locations
# ---------------------------------------------------------------------------
def _env_prefix():
    lines = [
        "export MKL_NUM_THREADS=1",
        "export OPENBLAS_NUM_THREADS=1",
        "export NUMEXPR_NUM_THREADS=1",
        "export OMP_NUM_THREADS=1",
    ]
    if config.get("prscsx_mt_dir"):
        lines.append('export PRSCSX_MT_DIR="%s"' % config["prscsx_mt_dir"])
    if config.get("prscsx_dir"):
        lines.append('export PRSCSX_DIR="%s"' % config["prscsx_dir"])
    return "\n".join(lines)

ENV_PREFIX = _env_prefix()
PYTHON     = config.get("python", "python3")

# collect/all touch tiny files — keep them off the scheduler.
localrules: all, collect, prsxtra, collect_prsxtra, analyze_prsxtra


rule all:
    input:
        ALL_RESULTS,
        DELTAS,


# One (scenario, seed) replicate → its tidy result.csv.
# The runner also writes data/ and per-method posterior files alongside it;
# only result.csv is tracked as the rule output.
rule run_replicate:
    output:
        RESULTS_DIR + "/{scenario}/seed_{seed}/result.csv",
    log:
        RESULTS_DIR + "/{scenario}/seed_{seed}/run.log",
    benchmark:
        RESULTS_DIR + "/{scenario}/seed_{seed}/benchmark.tsv"
    params:
        runner         = RUNNER,
        scenarios_file = SCENARIOS_FILE,
        results_dir    = RESULTS_DIR,
        python         = PYTHON,
        env_prefix     = ENV_PREFIX,
        n_snp          = config.get("n_snp", 2000),
        n_iter         = config.get("n_iter", 1000),
        n_burnin       = config.get("n_burnin", 500),
        sim_mode       = config.get("sim_mode", "realistic"),
        n_ref          = config.get("n_ref", 500),
        n_test         = config.get("n_test", 5000),
        ld_hetero      = config.get("ld_hetero", 0.15),
    threads: 1
    resources:
        runtime       = replicate_runtime,   # minutes
        mem_mb        = replicate_mem,        # MB
        cpus_per_task = 1,
    shell:
        r"""
        {params.env_prefix}

        {params.python} "{params.runner}" \
            --scenario_name  {wildcards.scenario} \
            --seed           {wildcards.seed} \
            --scenarios_file "{params.scenarios_file}" \
            --out_dir        "{params.results_dir}" \
            --n_snp          {params.n_snp} \
            --n_iter         {params.n_iter} \
            --n_burnin       {params.n_burnin} \
            --sim_mode       {params.sim_mode} \
            --n_ref          {params.n_ref} \
            --n_test         {params.n_test} \
            --ld_hetero      {params.ld_hetero} \
            > "{log}" 2>&1
        """


# Aggregate every replicate into all_results.csv + deltas.csv and print the
# rg × frac decomposition summary. Runs locally once all replicates exist.
rule collect:
    input:
        RESULT_CSVS,
    output:
        all_results = ALL_RESULTS,
        deltas      = DELTAS,
    params:
        collector   = COLLECTOR,
        results_dir = RESULTS_DIR,
        python      = PYTHON,
    shell:
        '{params.python} "{params.collector}" "{params.results_dir}" "{output.all_results}"'


# ---------------------------------------------------------------------------
# PRS-CSx-MT vs PRSxtra (compare_prsxtra.py). Not part of `all` — request it
# explicitly:  snakemake --profile profiles/slurm prsxtra
# ---------------------------------------------------------------------------
rule prsxtra:
    input:
        PRSXTRA_ALL,
        PRSXTRA_REPORT,


# One (scenario, seed, phi) replicate. Per phi value it runs 2 × n_trait PRS-CSx
# fits (raw GWAS and MTAG) + one PRS-CSx-MT fit — no more MCMC than a main-sweep
# replicate (2 phi arms × (n_trait + 1)), so it reuses the same resource scaling.
rule run_prsxtra:
    output:
        PRSXTRA_DIR + "/{scenario}/seed_{seed}/result_prsxtra_phi{phi}.csv",
    log:
        PRSXTRA_DIR + "/{scenario}/seed_{seed}/run_phi{phi}.log",
    benchmark:
        PRSXTRA_DIR + "/{scenario}/seed_{seed}/benchmark_phi{phi}.tsv"
    wildcard_constraints:
        seed = r"\d+",
        phi  = r"auto|[0-9.eE+-]+",
    params:
        runner         = PRSXTRA_RUNNER,
        scenarios_file = SCENARIOS_FILE,
        results_dir    = PRSXTRA_DIR,
        python         = PYTHON,
        env_prefix     = ENV_PREFIX,
        n_snp          = config.get("n_snp", 2000),
        n_iter         = config.get("n_iter", 1000),
        n_burnin       = config.get("n_burnin", 500),
        n_ref          = config.get("n_ref", 500),
        n_test         = config.get("n_test", 5000),
        ld_hetero      = config.get("ld_hetero", 0.15),
        tune_frac      = config.get("prsxtra_tune_frac", 0.5),
    threads: 1
    resources:
        runtime       = replicate_runtime,   # minutes
        mem_mb        = replicate_mem,        # MB
        cpus_per_task = 1,
    shell:
        r"""
        {params.env_prefix}

        {params.python} "{params.runner}" \
            --scenario_name  {wildcards.scenario} \
            --seed           {wildcards.seed} \
            --phi            {wildcards.phi} \
            --scenarios_file "{params.scenarios_file}" \
            --out_dir        "{params.results_dir}" \
            --n_snp          {params.n_snp} \
            --n_iter         {params.n_iter} \
            --n_burnin       {params.n_burnin} \
            --n_ref          {params.n_ref} \
            --n_test         {params.n_test} \
            --ld_hetero      {params.ld_hetero} \
            --tune_frac      {params.tune_frac} \
            > "{log}" 2>&1
        """


# Aggregate every PRSxtra replicate into all_results_prsxtra.csv and write the
# per-cell summary (method means + paired diffs vs prsxtra) to summary_prsxtra.txt.
rule collect_prsxtra:
    input:
        PRSXTRA_CSVS,
    output:
        all_results = PRSXTRA_ALL,
        summary     = PRSXTRA_DIR + "/summary_prsxtra.txt",
    params:
        runner      = PRSXTRA_RUNNER,
        results_dir = PRSXTRA_DIR,
        python      = PYTHON,
    shell:
        '{params.python} "{params.runner}" --collect "{params.results_dir}"'
        ' --collect_out "{output.all_results}" > "{output.summary}"'


# Tables (method_summary / contrasts_*.csv), report.md and figures under
# sim_sweep/analysis_prsxtra/. Reads the collected CSV, so it reruns whenever
# collect_prsxtra does. The outputs are small — commit these, not results_prsxtra/.
# Re-run just this step:  snakemake ... -R analyze_prsxtra prsxtra
rule analyze_prsxtra:
    input:
        all_results = PRSXTRA_ALL,
        analyzer    = PRSXTRA_ANALYZER,
    output:
        report = PRSXTRA_REPORT,
    params:
        python         = PYTHON,
        analysis_dir   = PRSXTRA_ANALYSIS,
        scenarios_file = SCENARIOS_FILE,
        n_seeds        = N_REPLICATES,
        groups         = PRSXTRA_GROUPS,
    log:
        PRSXTRA_ANALYSIS + "/analyze.log",
    run:
        # one report per scenario group; the first group writes analysis_prsxtra/,
        # any further group writes analysis_prsxtra_<group>/
        for i, g in enumerate(params.groups):
            out = params.analysis_dir + ("" if i == 0 else "_" + g)
            shell(
                '{params.python} "{input.analyzer}" "{input.all_results}"'
                ' --group %s --n_seeds {params.n_seeds}'
                ' --scenarios_file "{params.scenarios_file}" --out_dir "%s"'
                ' >> "{log}" 2>&1' % (g, out))
